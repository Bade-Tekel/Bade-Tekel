/* style.css */
body {
  margin: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #0d1b2a;
  color: #ffffff;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
  background-color: #1b263b;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
}

.logo {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 2px;
}

.nav a {
  color: #ffffff;
  text-decoration: none;
  margin-left: 20px;
  font-size: 16px;
  transition: color 0.3s;
}

.nav a:hover {
  color: #4dabf7;
}

.hero {
  text-align: center;
  padding: 100px 20px;
  background: linear-gradient(to bottom, #1b263b, #0d1b2a);
}

.hero h1 {
  font-size: 48px;
  margin-bottom: 10px;
  color: #ffffff;
}

.hero p {
  font-size: 20px;
  color: #c0d6df;
}

.search-filter {
  display: flex;
  justify-content: center;
  padding: 20px 0;
}

#search-bar {
  padding: 10px;
  font-size: 16px;
  width: 250px;
  border-radius: 6px;
  border: 1px solid #ccc;
  margin-right: 10px;
}

#category-filter {
  padding: 10px;
  font-size: 16px;
  border-radius: 6px;
  border: 1px solid #ccc;
  background-color: #ffffff;
}

.popular {
  padding: 60px 40px;
}

.popular h2 {
  text-align: center;
  font-size: 32px;
  margin-bottom: 40px;
  color: #ffffff;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.product-card {
  background-color: #1b263b;
  border-radius: 10px;
  padding: 20px;
  text-align: center;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

.product-card img {
  width: 100%;
  height: auto;
  border-radius: 8px;
  margin-bottom: 10px;
}

.product-card h3 {
  font-size: 20px;
  margin: 10px 0;
  color: #ffffff;
}

.product-card p {
  font-size: 18px;
  color: #90e0ef;
}

.product-card button {
  background-color: #4dabf7;
  color: #0d1b2a;
  border: none;
  padding: 10px 16px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: bold;
  transition: background-color 0.3s;
}

.product-card button:hover {
  background-color: #74c0fc;
}

.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  justify-content: center;
  align-items: center;
}

.modal-content {
  background-color: #ffffff;
  color: #0d1b2a;
  border-radius: 8px;
  padding: 20px;
  text-align: center;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
}

.close-btn {
  color: #bbb;
  font-size: 28px;
  font-weight: bold;
  cursor: pointer;
  position: absolute;
  top: 10px;
  right: 20px;
}

.close-btn:hover,
.close-btn:focus {
  color: #000;
  text-decoration: none;
  cursor: pointer;
}

.footer {
  text-align: center;
  padding: 20px;
  background-color: #1b263b;
  color: #ffffff;
  font-size: 14px;
}
